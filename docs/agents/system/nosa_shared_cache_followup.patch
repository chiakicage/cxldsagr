+class InstrumentedBackend:
+    def __init__(self, *, fail=None):
+        self.events = []
+        self.active = False
+        self.fail = fail
+        self.outside = lambda value: value - 100
+        self.leased_attention = lambda value: value + 1
+        self.model = SimpleNamespace(main_attention=self.outside)
+        self.workspace = SimpleNamespace(profile_work_intervals=False)
+
+    def _validate_ids(self, session, ids, *, prefill):
+        assert not prefill and not self.active
+        self.events.append("validate")
+        if self.fail == "validate":
+            raise ValueError("injected validation failure")
+
+    @contextmanager
+    def execution_lease(self, session):
+        self.active = True
+        self.events.append("acquire")
+        self.model.main_attention = self.leased_attention
+        try:
+            yield
+        finally:
+            assert self.model.main_attention is self.leased_attention
+            self.events.append("release")
+            self.model.main_attention = self.outside
+            self.active = False
+
+    def _forward(self, session, ids):
+        assert self.active
+        self.events.append("forward")
+        if self.fail == "forward":
+            raise RuntimeError("injected forward failure")
+        return self.model.main_attention(ids)
+
+    def synchronize(self):
+        assert self.active
+        self.events.append("synchronize")
+
+
+class BorrowedSession:
+    def __init__(self, backend):
+        self.backend = backend
+
+    @property
+    def attention_workspace(self):
+        assert self.backend.active
+        return self.backend.workspace
+
