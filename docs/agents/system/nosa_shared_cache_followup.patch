+        saved.unlink()
+    elif mutation == "extra":
+        saved.with_name("unlisted.py").write_text("not in manifest\n")
+    else:
+        saved.write_text("corrupted saved runtime source\n")
+    with pytest.raises(RuntimeError, match="Saved formal source"):
+        profile._verify_formal_sources(formal, root)
+
+
+@pytest.mark.parametrize("name", ["../outside.py", "/outside.py", "./models/nosa/a.py", "."])
+def test_formal_sources_reject_noncanonical_manifest_paths(formal_source_fixture, name):
+    root, formal, manifest, _ = formal_source_fixture
+    manifest[name] = "0" * 64
+    _save_formal_manifest(formal, manifest)
+    with pytest.raises(ValueError, match="canonical relative paths"):
+        profile._verify_formal_sources(formal, root)
+
+
+def test_formal_sources_preserve_formal_snapshot_exclusions(formal_source_fixture):
+    root, formal, _, _ = formal_source_fixture
+    for name in (
+        "models/nosa/__pycache__/cached.py",
+        "operators/nosa/generated/generated.cu",
+        "operators/nosa/build/built.cpp",
+        "cache/output/result.py",
+        "experiments/gr_serving/output/data/run/copy.py",
+        "models/nosa/README.md",
