+def _formal_source_paths(root, *, include_official):
+    """Match the formal measure.source_snapshot scope, including untracked files."""
+    extensions = {".py", ".sh", ".cu", ".cuh", ".cpp", ".h", ".hpp"}
+    paths = set()
+    for directory in ("models", "layers", "operators", "cache", "executor", "serving", "GR"):
+        paths.update(
+            path
+            for path in (root / directory).rglob("*")
+            if path.is_file()
+            and path.suffix in extensions
+            and not any(
+                part in ("__pycache__", "output", "generated", "build") for part in path.parts
+            )
+        )
+    paths.update(
+        path
+        for path in (root / "experiments/gr_serving").rglob("*")
+        if path.is_file() and path.suffix in (".py", ".sh") and "output" not in path.parts
+    )
+    if include_official:
+        from experiments.deepseek_v32_echo_prefill.src.backend_provenance import source_files
+
+        # source_files owns the official dependency scope. relative_to below also
+        # prevents a caller using another root from silently checking this checkout.
+        paths.update(source_files())
+    return {str(path.relative_to(root)) for path in paths}
