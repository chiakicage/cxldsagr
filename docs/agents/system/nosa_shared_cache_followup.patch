+                del manifest[name]
+                (formal / "source" / name).unlink()
+        _save_formal_manifest(formal, manifest)
+        with pytest.raises(RuntimeError, match="Formal source coverage changed"):
+            profile._verify_formal_sources(formal, root)
+    else:
+        assert profile._verify_formal_sources(formal, root)["source_sha256"] == digest
