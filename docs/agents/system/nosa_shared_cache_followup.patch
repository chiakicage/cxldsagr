+    elif mutation == "noninteger_bytes":
+        sample["memory_after"]["shared"]["dram"] = False
+    else:
+        directory = output / "samples" / sample["case"] / sample["mode"]
+        torch.save(torch.ones((1, 4), dtype=torch.bfloat16), directory / "profiled_hidden.pt")
+    (output / "metadata.json").write_text(json.dumps(metadata))
+    with pytest.raises(ValueError):
+        profile.verify_accepted_output(output, raw_profile["run_id"])
+
+
+def _save_formal_manifest(formal, manifest):
+    metadata = json.loads((formal / "metadata.json").read_text())
+    metadata["source_sha256"] = hashlib.sha256(
+        json.dumps(manifest, sort_keys=True).encode()
+    ).hexdigest()
+    (formal / "source_manifest.json").write_text(json.dumps(manifest))
+    (formal / "metadata.json").write_text(json.dumps(metadata))
+
+
+@pytest.mark.parametrize(
+    "name",
+    [
+        "models/nosa/tests/test_transfer_metrics.py",
+        "experiments/gr_serving/tests/test_profile_shared.py",
+        "operators/nosa/attention/new_kernel.cuh",
+    ],
+)
+def test_formal_sources_reject_new_current_eligible_files(formal_source_fixture, name):
+    root, formal, _, _ = formal_source_fixture
+    current = root / name
