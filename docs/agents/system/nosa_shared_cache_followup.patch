+    current.write_text("new implementation or validation\n")
+    with pytest.raises(RuntimeError, match="Formal source coverage changed"):
+        profile._verify_formal_sources(formal, root)
+
+
+@pytest.mark.parametrize("remove_saved", [False, True])
+def test_formal_sources_reject_filtered_manifest_even_with_refreshed_digest(
+    formal_source_fixture, remove_saved
+):
+    root, formal, manifest, _ = formal_source_fixture
+    name = "models/nosa/attention.py"
+    del manifest[name]
+    _save_formal_manifest(formal, manifest)
+    if remove_saved:
+        (formal / "source" / name).unlink()
+    with pytest.raises(RuntimeError, match="source coverage"):
+        profile._verify_formal_sources(formal, root)
+
+
+@pytest.mark.parametrize("mutation", ["missing", "extra", "corrupt"])
+def test_formal_sources_authenticate_complete_saved_runtime_copy(formal_source_fixture, mutation):
