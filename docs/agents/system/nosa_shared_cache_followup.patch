+def _diagnostic_plan(backend, formal, *, prefix, queries, num_users):
+    """Reserve trace before allocation and bind the uninstrumented plan to its run."""
+    from cache.prefix_pool import CacheFootprint
+    from operators.nosa.attention.offload.api import estimate_trace_rows
+
+    limits = {"max_session_capacity": prefix + queries, "max_candidate_tokens": queries}
+    caps = CacheFootprint(
+        **{tier: formal["parameters"][f"{tier}_budget_bytes"] for tier in ("hbm", "dram")}
+    )
+    plain = backend.plan_resources(caps, limits)
+    cases = [
+        case
+        for case in formal["cases"]
+        if (case["model"], case["scheme"], case["num_users"]) == ("nosa", backend.scheme, num_users)
+    ]
+    plain_bytes = {"hbm": plain.shared.hbm, "dram": plain.shared.dram}
+    if (
+        len(cases) != 1
+        or cases[0].get("cache_resource_plan") != dict(plain.metadata)
+        or cases[0].get("shared_reservation") != plain_bytes
+    ):
+        raise ValueError("Formal case must contain the same bounded NOSA shared plan")
+    reservation = backend.estimate_session_bytes(prefix + queries, prefix)
+    if cases[0].get("session_reservation") != reservation:
+        raise ValueError("Formal session reservation differs from diagnostic session layout")
+    trace_rows = estimate_trace_rows(
+        prefix + queries, plain.metadata["max_query_tokens"], backend.config.num_key_value_heads
+    )
+    trace_bytes = trace_rows * 4 * 8
+    diagnostic_caps = CacheFootprint(caps.hbm + trace_bytes, caps.dram)
+    plan = backend.plan_resources(diagnostic_caps, {**limits, "trace_capacity": trace_rows})
+    if plan.shared.hbm - plain.shared.hbm != trace_bytes or plan.shared.dram != plain.shared.dram:
+        raise ValueError("Diagnostic plan may add only explicitly reserved trace storage")
+    for tier in ("hbm", "dram"):
+        if getattr(plan.shared, tier) + reservation[tier] > getattr(diagnostic_caps, tier):
+            raise ValueError("Diagnostic shared workspace plus one session exceeds its budget")
+    return plan, {
+        "formal_plan": dict(plain.metadata),
+        "diagnostic_plan": dict(plan.metadata),
+        "formal_shared_reservation": plain_bytes,
+        "diagnostic_shared_reservation": {"hbm": plan.shared.hbm, "dram": plan.shared.dram},
+        "session_reservation": reservation,
+        "formal_cache_caps_bytes": {"hbm": caps.hbm, "dram": caps.dram},
+        "diagnostic_cache_caps_bytes": {
+            "hbm": diagnostic_caps.hbm,
+            "dram": diagnostic_caps.dram,
+        },
+        "diagnostic_extra_hbm_bytes": trace_bytes,
+        "scope": "one direct session; bounded execution storage; no multi-user LRU admission",
+    }
+
+
+def _memory_snapshot(backend, session, workspace):
+    return {
+        "session": backend.session_bytes(session),
+        "shared": backend.shared_bytes(),
+        "workspace_capacity_bytes": workspace.capacity_bytes,
+        "trace_storage_bytes": _tensor_bytes(workspace._trace_storage),
+        "trace_used_rows": len(workspace.last_work_intervals),
+    }
+
+
+def _execute_profiled_candidate(backend, session, candidate, wrap, export):
+    """Install the diagnostic inside the backend lease and export before return."""
+    backend._validate_ids(session, candidate, prefill=False)
+    with backend.execution_lease(session):
+        original = backend.model.main_attention
+        workspace = session.attention_workspace
+        try:
+            backend.model.main_attention = wrap(original, workspace)
+            output = backend._forward(session, candidate)
+            backend.synchronize()
+            evidence = export(workspace)
+        finally:
+            backend.model.main_attention = original
+            workspace.profile_work_intervals = False
+    return output, evidence
+
