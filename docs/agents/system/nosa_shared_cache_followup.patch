+def _validate_shared_resources(resources, *, scheme, prefix, queries, chunk_size):
+    """Validate schema-2 reservations without loading a model or using CUDA."""
+    try:
+        if any(type(value) is not int or value <= 0 for value in (prefix, queries, chunk_size)):
+            raise ValueError("Profile geometry must contain positive integer token bounds")
+        plain, diagnostic = resources["formal_plan"], resources["diagnostic_plan"]
+        query_bound = max(min(chunk_size, prefix + queries), queries)
+        expected = {
+            "policy_revision": "nosa_backend_workspace_v1",
+            "pool_scope": "backend_workspace",
+            "workspace_scope": "backend",
+            "host_scope": "session",
+            "scheme": scheme,
+            "max_session_capacity": prefix + queries,
+            "max_candidate_tokens": queries,
+            "max_query_tokens": query_bound,
+            "prefix_chunk_size": chunk_size,
+            "stage_count": 1,
+            "kv_heads": 2,
+            "head_dim": 128,
+            "query_heads": 32,
+            "layers": 32,
+            "dtype": "torch.bfloat16",
+            "trace_capacity": 0,
+        }
+        if scheme not in MODES or any(
+            plain.get(key) != value or type(plain.get(key)) is not type(value)
+            for key, value in expected.items()
+        ):
+            raise ValueError("Invalid formal shared plan geometry, policy, or ownership")
+        trace_rows = ((prefix + queries + 63) // 64) * 2 * 9
+        trace_rows += ((query_bound + 7) // 8) * 2 * 64
+        if (
+            diagnostic != {**plain, "trace_capacity": trace_rows}
+            or type(diagnostic["trace_capacity"]) is not int
+        ):
+            raise ValueError("Diagnostic plan must preserve the formal layout and reserve trace")
+        trace_bytes = trace_rows * 32
+        if resources["diagnostic_extra_hbm_bytes"] != trace_bytes:
+            raise ValueError("Diagnostic trace byte allowance differs from its row capacity")
+        fields = (
+            "formal_shared_reservation",
+            "diagnostic_shared_reservation",
+            "session_reservation",
+            "formal_cache_caps_bytes",
+            "diagnostic_cache_caps_bytes",
+        )
+        for name in fields:
+            values = resources[name]
+            if set(values) != {"hbm", "dram"} or any(
+                type(value) is not int or value < 0 for value in values.values()
+            ):
+                raise ValueError("Resource reservations require nonnegative integer tier bytes")
+        for tier in ("hbm", "dram"):
+            extra = trace_bytes if tier == "hbm" else 0
+            shared = resources["formal_shared_reservation"][tier]
+            diagnostic_shared = resources["diagnostic_shared_reservation"][tier]
+            caps = resources["formal_cache_caps_bytes"][tier]
+            diagnostic_caps = resources["diagnostic_cache_caps_bytes"][tier]
+            session = resources["session_reservation"][tier]
+            if diagnostic_shared != shared + extra or diagnostic_caps != caps + extra:
+                raise ValueError("Diagnostic budget/storage must add only reserved trace bytes")
+            if shared + session > caps or diagnostic_shared + session > diagnostic_caps:
+                raise ValueError("Shared plus session reservation exceeds diagnostic/formal caps")
+        if (
+            resources["formal_shared_reservation"]["dram"] != 0
+            or resources["session_reservation"]["dram"] <= 0
+        ):
+            raise ValueError("NOSA host backing must remain session-owned")
+    except (KeyError, TypeError) as exc:
+        raise ValueError("Missing or malformed schema-2 shared resource record") from exc
+
+
+def _validate_shared_sample(sample, resources, *, prefix, queries):
+    try:
+        diagnostic = resources["diagnostic_plan"]
+        trace_bytes = diagnostic["trace_capacity"] * 32
+        if (
+            sample["scheme"] != diagnostic["scheme"]
+            or sample["mode"] != MODES[sample["scheme"]]
+            or sample["diagnostic_extra_hbm_bytes"] != trace_bytes
+            or sample["trace_exported_before_lease_release"] is not True
+        ):
+            raise ValueError("Sample does not identify its reserved trace and execution lease")
+        before, after = sample["memory_before"], sample["memory_after"]
+        for memory in (before, after):
+            for name in ("session", "shared"):
+                if set(memory[name]) != {"hbm", "dram"} or any(
+                    type(value) is not int or value < 0 for value in memory[name].values()
+                ):
+                    raise ValueError("Actual shared/session bytes require integer tier values")
+            if (
+                memory["shared"] != resources["diagnostic_shared_reservation"]
+                or memory["trace_storage_bytes"] != trace_bytes
+            ):
+                raise ValueError("Actual shared/trace storage differs from its fixed reservation")
+            for tier in ("hbm", "dram"):
+                actual = memory["session"][tier]
+                if (
+                    type(actual) is not int
+                    or not 0 <= actual <= resources["session_reservation"][tier]
+                ):
+                    raise ValueError("Actual session storage exceeds its independent reservation")
+                if actual + memory["shared"][tier] > resources["diagnostic_cache_caps_bytes"][tier]:
+                    raise ValueError("Actual shared plus session bytes exceed the diagnostic cap")
+            workspace_bytes = memory["workspace_capacity_bytes"]
+            if (
+                type(workspace_bytes) is not int
+                or not trace_bytes <= workspace_bytes <= memory["shared"]["hbm"]
+            ):
+                raise ValueError("Invalid measured workspace capacity")
+        used_rows = ((prefix + 63) // 64) * 2 * 9 + ((queries + 7) // 8) * 2 * 64
+        if (
+            before["workspace_capacity_bytes"] != after["workspace_capacity_bytes"]
+            or type(before["trace_used_rows"]) is not int
+            or type(after["trace_used_rows"]) is not int
+            or before["trace_used_rows"] != 0
+            or after["trace_used_rows"] != used_rows
+            or used_rows > diagnostic["trace_capacity"]
+        ):
+            raise ValueError("Trace/attention workspace grew or used an unreserved trace extent")
+    except (KeyError, TypeError) as exc:
+        raise ValueError("Missing or malformed schema-2 sample memory record") from exc
+
