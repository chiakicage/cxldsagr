+        path.write_text("official source\n")
+    monkeypatch.setattr(measure, "ROOT", root)
+    monkeypatch.setattr(backend_provenance, "source_files", lambda: official)
+    formal = tmp_path / "measured"
+    formal.mkdir()
+    include_official = formal_scope != "base"
+    digest = measure.source_snapshot(formal, include_official=include_official)
+    metadata = {
+        "source_sha256": digest,
