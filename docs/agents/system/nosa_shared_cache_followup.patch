+        "parameters": {"models": ["deepseek_v32"] if formal_scope == "model" else ["nosa"]},
+    }
+    (formal / "metadata.json").write_text(json.dumps(metadata))
+    assert profile._verify_formal_sources(formal, root)["source_sha256"] == digest
+    new_source = root / "3rdparty/FlashMLA/csrc/new_kernel.cu"
+    new_source.write_text("new official source\n")
+    official.add(new_source)
+    if include_official:
+        with pytest.raises(RuntimeError, match="Formal source coverage changed"):
+            profile._verify_formal_sources(formal, root)
+        # Retain only base sources and recompute the digest: formal run metadata
+        # must still require the official scope, independent of manifest markers.
+        manifest = json.loads((formal / "source_manifest.json").read_text())
+        for name in list(manifest):
