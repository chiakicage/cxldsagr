+from cache.prefix_pool import CacheFootprint
+from experiments.gr_serving.src import profile
+from experiments.gr_serving.tests import test_profile as legacy_profile_tests
+from models.nosa.serving_resources import NosaExecutionResources
+from models.nosa.session_budget import estimate_session_bytes
+
+accepted_output = legacy_profile_tests.accepted_output
+interval_profile = legacy_profile_tests.interval_profile
+profile_module = legacy_profile_tests.profile_module
