+@pytest.mark.parametrize("mutation", ["missing_plan", "changed_q", "shared_bytes", "session_bytes"])
+def test_diagnostic_plan_rejects_old_or_different_formal_resources(mutation):
+    backend, formal = planning_backend()
+    case = formal["cases"][0]
+    if mutation == "missing_plan":
+        del case["cache_resource_plan"]
+    elif mutation == "changed_q":
+        case["cache_resource_plan"]["max_query_tokens"] += 1
+    elif mutation == "shared_bytes":
+        case["shared_reservation"]["hbm"] += 1
+    else:
+        case["session_reservation"]["hbm"] += 1
+    with pytest.raises(ValueError):
+        profile._diagnostic_plan(backend, formal, prefix=16384, queries=1024, num_users=8)
+    assert backend.resources.plan is None
