+    # The clocks differ by hundreds of microseconds; no timestamp adjustment
+    # was made to convince the original shared parser to accept these events.
+    assert not generic.audit_trace(trace, limits={"cuda:0": 512, "cpu": 16}, cuda_history=history)[
