+@pytest.mark.parametrize("failure", [None, "validate", "forward", "export"])
+def test_instrumentation_survives_backend_attention_replacement_and_exports_inside_lease(failure):
+    backend = InstrumentedBackend(fail=failure)
+    session = BorrowedSession(backend)
+
+    def wrap(original, workspace):
+        assert backend.active and original is backend.leased_attention
+        workspace.profile_work_intervals = True
+        return lambda value: original(value) * 2
+
+    def export(workspace):
+        assert backend.active and workspace is backend.workspace
+        backend.events.append("export")
+        if failure == "export":
+            raise RuntimeError("injected export failure")
+        return {"copied": True}
+
+    if failure:
+        with pytest.raises((RuntimeError, ValueError), match="injected"):
+            profile._execute_profiled_candidate(backend, session, torch.tensor([1]), wrap, export)
+    else:
+        hidden, evidence = profile._execute_profiled_candidate(
+            backend, session, torch.tensor([1]), wrap, export
+        )
+        assert hidden.tolist() == [4]
+        assert evidence == {"copied": True}
+        assert backend.events == [
+            "validate",
+            "acquire",
+            "forward",
+            "synchronize",
+            "export",
+            "release",
+        ]
+    assert backend.model.main_attention is backend.outside
+    assert not backend.active
+    assert not backend.workspace.profile_work_intervals
+    if failure == "validate":
+        assert backend.events == ["validate"]
