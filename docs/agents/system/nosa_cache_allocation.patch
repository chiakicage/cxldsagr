+def test_real_cpu_shared_backend_retains_wrapper_through_every_model_layer():
+    from models.nosa.tests.test_serving_resources import allocated_backend, tokens
+
+    with allocated_backend("serial_sparse", capacity=96, candidate=17) as (backend, _):
+        session = backend.create_session(96)
+        backend.prefill(session, tokens(79))
+        expected = backend.extend(session, tokens(17, 2)).clone()
+        backend.truncate(session, 79)
+        layers = []
+
+        def wrap(original, workspace):
+            def attention(q, selection, access, context):
+                assert access is session
+                assert backend.resources._active_session is session
+                layers.append(context.layer_idx)
+                return original(q, selection, access, context)
+
+            return attention
+
+        def export(workspace):
+            assert backend.resources._active_session is session
+            assert workspace is backend.resources.fetch_workspace
+            return tuple(layers)
+
+        actual, observed_layers = profile._execute_profiled_candidate(
+            backend, session, tokens(17, 2), wrap, export
+        )
+        torch.testing.assert_close(actual, expected, atol=0, rtol=0)
