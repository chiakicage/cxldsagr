+def planning_backend(scheme="serial_sparse", *, capacity=17408, device="cpu"):
+    resources = NosaExecutionResources(
+        scheme=scheme,
+        layers=32,
+        kv_heads=2,
+        head_dim=128,
+        query_heads=32,
+        max_seq_len=capacity,
+        chunk_size=1024,
+        dtype=torch.bfloat16,
+        device="cpu",
+    )
+    resources.device = torch.device(device)
+    backend = SimpleNamespace(
+        scheme=scheme,
+        config=SimpleNamespace(num_key_value_heads=2),
+        resources=resources,
+        plan_resources=resources.plan_resources,
+        estimate_session_bytes=lambda capacity, prefix: estimate_session_bytes(
+            capacity=capacity,
+            queries=max(min(1024, prefix), capacity - prefix),
+            layers=32,
+            kv_heads=2,
+            query_heads=32,
+            head_dim=128,
+            dtype=torch.bfloat16,
+            device=device,
+            scheme=scheme,
+        ),
+    )
+    session_reservation = backend.estimate_session_bytes(capacity, capacity - 1024)
+    caps = CacheFootprint(1 << 30, max(1 << 30, session_reservation["dram"]))
+    plan = backend.plan_resources(
+        caps, {"max_session_capacity": capacity, "max_candidate_tokens": 1024}
+    )
+    formal = {
+        "status": "accepted",
+        "run_id": "formal-shared",
+        "parameters": {
+            "hbm_budget_bytes": caps.hbm,
+            "dram_budget_bytes": caps.dram,
+        },
+        "cases": [
+            {
+                "model": "nosa",
+                "scheme": scheme,
+                "num_users": 8,
+                "cache_resource_plan": dict(plan.metadata),
+                "shared_reservation": {"hbm": plan.shared.hbm, "dram": plan.shared.dram},
+                "session_reservation": session_reservation,
+            }
+        ],
+    }
+    return backend, formal
+
+
+def test_diagnostic_plan_is_pure_and_adds_only_explicit_trace_storage(monkeypatch):
+    backend, formal = planning_backend()
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("diagnostic planning must not allocate")
+
+    monkeypatch.setattr(torch, "empty", forbidden)
+    plan, record = profile._diagnostic_plan(
+        backend, formal, prefix=16384, queries=1024, num_users=8
+    )
+    assert backend.resources.plan is None
+    assert plan.metadata["trace_capacity"] > 0
+    assert record["diagnostic_extra_hbm_bytes"] == plan.metadata["trace_capacity"] * 32
+    assert record["diagnostic_shared_reservation"]["hbm"] == (
+        record["formal_shared_reservation"]["hbm"] + record["diagnostic_extra_hbm_bytes"]
+    )
+    profile._validate_shared_resources(
+        record, scheme="serial_sparse", prefix=16384, queries=1024, chunk_size=1024
+    )
+
+
+def test_cuda_diagnostic_distinguishes_trace_payload_from_allocator_reservation(monkeypatch):
+    from models.nosa import serving_resources
+    from models.nosa.allocation_budget import allocator_policy
+
+    # Exercise only pure CUDA arithmetic on a CPU test host. Runtime allocator
+    # configuration validation has separate tests; never initialize CUDA here.
+    monkeypatch.setattr(NosaExecutionResources, "validate_native", lambda self: None)
+    monkeypatch.setattr(
+        serving_resources,
+        "validate_allocator",
+        lambda device: {"policy": allocator_policy(device), "configuration_key": "fixture"},
+    )
+    backend, formal = planning_backend(capacity=66560, device="cuda:0")
+    plan, record = profile._diagnostic_plan(
+        backend, formal, prefix=65536, queries=1024, num_users=8
+    )
+    trace_payload = plan.metadata["trace_capacity"] * 32
+    assert record["diagnostic_extra_hbm_bytes"] == trace_payload + (1 << 20)
+    logical_shared = plan.metadata["logical_shared_hbm_bytes"]
+    assert plan.shared.hbm > logical_shared
+    profile._validate_shared_resources(
+        record, scheme="serial_sparse", prefix=65536, queries=1024, chunk_size=1024
+    )
+    memory = {
+        "session": {"hbm": 2048, "dram": 8192},
+        "shared": {"hbm": logical_shared, "dram": 0},
+        "workspace_capacity_bytes": logical_shared,
+        "trace_storage_bytes": trace_payload,
+        "trace_used_rows": 0,
+    }
+    sample = {
+        "scheme": "serial_sparse",
+        "mode": profile.MODES["serial_sparse"],
+        "diagnostic_extra_hbm_bytes": record["diagnostic_extra_hbm_bytes"],
+        "trace_exported_before_lease_release": True,
+        "memory_before": memory,
+        "memory_after": {**memory, "trace_used_rows": 1024 * 2 * 9 + 128 * 2 * 64},
+    }
+    profile._validate_shared_sample(sample, record, prefix=65536, queries=1024)
+    forged = copy.deepcopy(sample)
+    forged["memory_after"]["trace_storage_bytes"] = record["diagnostic_extra_hbm_bytes"]
+    with pytest.raises(ValueError):
+        profile._validate_shared_sample(forged, record, prefix=65536, queries=1024)
+
