        },
        {
          "start_line": 469,
          "end_line": 471,
          "finding": "Invocation cap=min(runtime maximum,compile-time maximum)."
        },
        {
          "start_line": 530,
          "end_line": 540,
          "finding": "Query precheck stops further attempts after observing counter>=cap."
        },
        {
          "start_line": 564,
          "end_line": 581,
          "finding": "Candidate precheck also observes the volatile counter; concurrent warps can exhaust cap between precheck and reservation."
        }
