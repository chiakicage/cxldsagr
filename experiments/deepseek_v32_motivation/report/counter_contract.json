      "ranges": [
        {
          "start_line": 18,
          "end_line": 28,
          "finding": "Eligible live-map misses temporarily claim ownership, atomically reserve ranks, and count count-granted rejected reservations."
        },
        {
          "start_line": 35,
          "end_line": 49,
          "finding": "Only granted ranks publish slot ownership/allocation_log. A rejected claim performs CAS(-1,MISSING), without these accepted-slot writes."
        },
        {
          "start_line": 52,
          "end_line": 63,
          "finding": "Only granted ranks copy records; stats[0] counts actual granted copies."
        }
      ]
    },
