{
  "schema": "deepseek-c10-echo-rejected-reservation-counter-contract-v1",
  "status": "source_reviewed",
  "created_utc": "2026-10-06T18:11:25.779679+00:00",
  "batch_id": "deepseek_motivation_matrix_20261007_01",
  "field": "cache_diagnostics.layers[layer].prefetch_capacity_failures",
  "native_storage": "prefetch_stats[2]",
  "meaning": "Rejected reservation attempts after an eligible miss wins a temporary live-map claim; not failed accepted transfers, lost records, bus bytes, or numerical errors.",
  "variation_reason": "Volatile prechecks can observe cap exhaustion at different times. A warp that already passed its precheck may reserve after another warp fills cap and count rejections. This attempt count is not specified to be equal across independent executions.",
  "accepted_comparison_scope": {
    "scheme": "echo",
    "candidate_persistence": "gpu_transient",
    "pool_tokens": 65536,
    "prefetch_cap": 8192,
    "requires_actual_prefetched_records_in_both_runs": 8192,
    "values": "Both must be nonnegative integers, excluding booleans. Every unequal pair must retain request/layer identity and both exact original values.",
    "all_other_diagnostics": "Exact recursive equality, including successful prefetch, eviction, recall, selected/resident counts, bytes, layout and capacities. Same-named fields in any other location are not exempt."
  },
  "does_not_establish": [
    "Identical logical prefetch sets or priority trajectories across check/bench.",
    "A per-execution proof of arbitrary cache state transitions.",
    "Applicability of the real-three-layer cold single-session H+A<=P exception to C10.",
    "Benchmark output bytes saved or re-compared; numerical evidence remains the matching independent check."
  ],
  "source_evidence": {
    "operators/deepseek_v32/indexer/csrc/echo_cache.cuh": {
